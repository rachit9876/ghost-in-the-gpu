{
  "manifest_version": 3,
  "name": "Ghost in the GPU — Sensory Logger",
  "version": "1.0.0",
  "description": "Log web images directly into your Ghost in the GPU neural taste engine (Alt+L).",
  "permissions": ["storage", "activeTab"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["styles.css"],
      "matches": ["<all_urls>"]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Ghost in the GPU"
  },
  "commands": {
    "log_hovered_image": {
      "suggested_key": {
        "default": "Alt+L",
        "mac": "Alt+L"
      },
      "description": "Log the currently hovered image"
    }
  }
}