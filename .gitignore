# .gitignore for Ghost in the GPU

# Environment
.venv/
venv/
env/
__pycache__/
*.py[cod]
*$py.class
*.pyd

# User Data & Personal Image Library (Keep personal media private by default)
ghost/data/
*.npy

# Models & Checkpoints (User multi-domain neural brains & weights)
ghost/models/*
!ghost/models/.gitkeep
ghost/models_backup*/
*_backup*/
*.pkl
*.pt
*.bin
*.onnx
*.safetensors

# IDE & OS
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
*.log

# ═══════════════════════════════════════════════════
# Backups, atomic temp files, and test artifacts
# ═══════════════════════════════════════════════════
*.bak.*
*.bak
*.tmp
.pytest_cache/
.coverage
htmlcov/

# Research / reference materials
encoder_research_paper_*.pdf
